# Server-only contact integration values. Do not expose these with NEXT_PUBLIC_.
N8N_WEBHOOK_URL=
N8N_AI_LEAD_ASSISTANT_WEBHOOK_URL=
CONTACT_EMAIL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=5

# Public Umami tracker configuration. These are not secrets, but keep them in environment variables.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Server-only AI assistant values. Keep disabled unless explicitly enabled for QA or launch.
AI_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
